---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import { site, socials } from '../config/site';
import { getPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';

const posts = (await getPosts()).slice(0, 4);
const projects = (await getProjects()).slice(0, site.projects.homeCount);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.title,
  url: new URL('/', Astro.site).href,
  description: site.description,
};
---

<BaseLayout jsonLd={jsonLd}>
  <h1 class="sr-only">{site.title}</h1>

  <section class="section">
    <p class="lead">
      I'm {site.author}. I build open-source tools for problems I run into myself, mostly on{' '}
      <a href={`https://github.com/${site.github}`}>GitHub</a>, and write up here how they came together.
    </p>
  </section>

  <section class="section">
    <h2 class="label">Writing</h2>
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="empty">Nothing published yet.</p>}
    {posts.length > 0 && <a class="more" href="/writing/">All posts</a>}
  </section>

  <section class="section">
    <h2 class="label">Projects</h2>
    {projects.length > 0 ? <ProjectList projects={projects} /> : <p class="empty">Nothing here yet.</p>}
    {projects.length > 0 && <a class="more" href="/projects/">All projects</a>}
  </section>

  <section class="section">
    <h2 class="label">Elsewhere</h2>
    <div class="elsewhere">
      {socials.map((social) => <a href={social.href}>{social.label}</a>)}
    </div>
  </section>
</BaseLayout>
