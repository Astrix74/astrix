---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterList from '../components/ChapterList.astro';
import { site } from '../config/site';
import { localize, type Alternates, type Locale } from '../i18n';
import { strings } from '../i18n/strings';
import { entryHref } from '../lib/links';
import { seriesUrl, type SeriesWithChapters } from '../lib/series';

interface Props {
  item: SeriesWithChapters;
  prerequisites: SeriesWithChapters[];
  locale: Locale;
  alternates: Alternates;
}

const { item, prerequisites, locale, alternates } = Astro.props;
const t = strings[locale];
const { series, display, chapters } = item;
const { Content } = await render(display);
const url = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWorkSeries',
  name: display.data.title,
  description: display.data.description,
  url,
  author: { '@type': 'Person', name: site.author, url: new URL(localize(locale, '/'), Astro.site).href },
  hasPart: chapters.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    position: post.data.chapter,
    url: new URL(entryHref(post), Astro.site).href,
  })),
};
---

<BaseLayout
  locale={locale}
  alternates={alternates}
  title={display.data.title}
  description={display.data.description}
  image={`/og/series/${series.id}.png`}
  jsonLd={jsonLd}
>
  <a class="back" href={localize(locale, '/series/')}>{t.series.back}</a>
  <h1 class="post-title">{display.data.title}</h1>
  <p class="post-meta">
    {t.series.chapters(chapters.length)}
    {
      prerequisites.length > 0 && (
        <>
          {t.series.readFirst}
          {prerequisites.map((other, i) => (
            <>
              {i > 0 && ', '}
              <a href={seriesUrl(locale, other.series.id)}>{other.display.data.title}</a>
            </>
          ))}
        </>
      )
    }
  </p>
  <div class="prose">
    <Content />
  </div>
  <section class="section-chapters" aria-labelledby="chapters">
    <h2 class="label" id="chapters">{t.series.chaptersLabel}</h2>
    <ChapterList chapters={chapters} locale={locale} planned={display.data.planned} />
  </section>
  <a class="more" href={entryHref(chapters[0])}>{t.series.startWith(chapters[0].data.chapter!)}</a>
</BaseLayout>
