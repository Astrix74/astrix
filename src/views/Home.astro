---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import SeriesList from '../components/SeriesList.astro';
import { site, socials } from '../config/site';
import { localize, type Locale } from '../i18n';
import { strings } from '../i18n/strings';
import { entryHref } from '../lib/links';
import { getPapers } from '../lib/papers';
import { formatDate, getPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';
import { getSeries } from '../lib/series';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const p = (path: string) => localize(locale, path);
const series = await getSeries(locale);
const papers = (await getPapers(locale)).slice(0, 3);
const posts = (await getPosts(locale)).slice(0, 4);
const projects = (await getProjects()).slice(0, site.projects.homeCount);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.title,
  url: new URL(p('/'), Astro.site).href,
  description: t.siteDescription,
};
---

<BaseLayout locale={locale} jsonLd={jsonLd}>
  <h1 class="sr-only">{site.title}</h1>

  <section class="section">
    <p class="lead">{t.homeLead(site.author)}</p>
  </section>

  {
    series.length > 0 && (
      <section class="section">
        <h2 class="label">{t.labels.series}</h2>
        <SeriesList items={series} locale={locale} />
      </section>
    )
  }

  {
    papers.length > 0 && (
      <section class="section">
        <h2 class="label">{t.labels.papers}</h2>
        <ul class="entries">
          {papers.map((paper) => (
            <li>
              <time class="date" datetime={paper.data.date.toISOString()}>
                {formatDate(paper.data.date)}
              </time>
              <a href={entryHref(paper)}>{paper.data.title}</a>
            </li>
          ))}
        </ul>
        <a class="more" href={p('/papers/')}>{t.allPapers}</a>
      </section>
    )
  }

  <section class="section">
    <h2 class="label">{t.labels.writing}</h2>
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="empty">{t.nothingPublished}</p>}
    {posts.length > 0 && <a class="more" href={p('/writing/')}>{t.allPosts}</a>}
  </section>

  {
    projects.length > 0 && (
      <section class="section">
        <h2 class="label">{t.labels.projects}</h2>
        <ProjectList projects={projects} locale={locale} />
        <a class="more" href={p('/projects/')}>{t.allProjects}</a>
      </section>
    )
  }

  <section class="section">
    <h2 class="label">{t.labels.elsewhere}</h2>
    <div class="elsewhere">
      {socials.map((social) => <a href={social.href.startsWith('/') ? p(social.href) : social.href}>{social.label}</a>)}
    </div>
  </section>
</BaseLayout>
