---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

// The footnotes section brings its own visually hidden heading; it is not part of the post's outline.
const items = Astro.props.headings.filter(
  (heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label',
);
---

{
  items.length >= 3 && (
    <details class="toc">
      <summary>Contents</summary>
      <ol>
        {items.map((heading) => (
          <li class={heading.depth === 3 ? 'toc-sub' : undefined}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </details>
  )
}
