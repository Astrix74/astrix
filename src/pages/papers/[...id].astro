---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/Byline.astro';
import ProseScripts from '../../components/ProseScripts.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { site } from '../../config/site';
import { getPapers } from '../../lib/papers';
import { formatDate, readingMinutes } from '../../lib/posts';
import { referencesOf } from '../../lib/references';

export async function getStaticPaths() {
  const papers = await getPapers();
  return papers.map((paper) => ({ params: { id: paper.id }, props: { paper } }));
}

const { paper } = Astro.props;
const { Content, headings } = await render(paper);
const references = await referencesOf(paper);
const { date, updated } = paper.data;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = `/og/papers/${paper.id}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: paper.data.title,
  description: paper.data.description,
  abstract: paper.data.abstract,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Person', name: site.author, url: new URL('/', Astro.site).href },
  mainEntityOfPage: canonical,
  image: new URL(image, Astro.site).href,
};
---

<BaseLayout title={paper.data.title} description={paper.data.description} type="article" image={image} jsonLd={jsonLd}>
  <article>
    <a class="back" href="/papers/">← papers</a>
    <h1 class="post-title">{paper.data.title}</h1>
    <p class="post-meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {
        updated && formatDate(updated) !== formatDate(date) && (
          <>
            {' · updated '}
            <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
          </>
        )
      }
      {` · ${readingMinutes(paper.body)} min read · not peer-reviewed`}
      {paper.data.draft && ' · draft'}
    </p>
    <Byline writtenBy={paper.data.writtenBy} />
    <section class="abstract" aria-labelledby="abstract-label">
      <h2 class="label" id="abstract-label">Abstract</h2>
      <p>{paper.data.abstract}</p>
    </section>
    <TableOfContents headings={headings} />
    <div class="prose">
      <Content />
    </div>
    {
      references.length > 0 && (
        <section class="more-posts" aria-labelledby="paper-references">
          <h2 class="label" id="paper-references">
            References
          </h2>
          <ReferenceList references={references} />
        </section>
      )
    }
  </article>
  <ProseScripts />
</BaseLayout>
