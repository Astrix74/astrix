---
import { site } from '../config/site';
import { languageTag, type Locale } from '../i18n';
import { strings } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const { repo, repoId, category, categoryId } = site.comments;
const enabled = Boolean(repoId && categoryId);
---

{
  enabled && (
    <section class="comments" aria-label={strings[locale].comments}>
      <h2 class="label">{strings[locale].comments}</h2>
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-lang={languageTag[locale]}
        data-loading="lazy"
        crossorigin="anonymous"
        async
      />
    </section>
  )
}
