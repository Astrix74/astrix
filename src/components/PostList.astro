---
import { localeOf } from '../i18n';
import { strings } from '../i18n/strings';
import { entryHref } from '../lib/links';
import { formatDate, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="entries">
  {
    posts.map((post) => (
      <li>
        <time class="date" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <a href={entryHref(post)}>
          {post.data.title}
          {post.data.draft && <span class="draft">{strings[localeOf(post.id)].draftSuffix}</span>}
        </a>
      </li>
    ))
  }
</ul>
