---
import type { Locale } from '../i18n';
import { strings } from '../i18n/strings';
import { seriesUrl, type SeriesWithChapters } from '../lib/series';

interface Props {
  items: SeriesWithChapters[];
  locale: Locale;
}

const { items, locale } = Astro.props;
const t = strings[locale];
const visible = new Map(items.map((item) => [item.series.id, item]));
---

<ol class="series-list">
  {
    items.map((item, index) => {
      // Prerequisites are listed only when they are themselves visible.
      const first = item.series.data.prerequisites.flatMap(({ id }) => visible.get(id) ?? []);
      return (
        <li>
          <span class="date">{String(index + 1).padStart(2, '0')}</span>
          <div class="series-item">
            <a class="series-title" href={seriesUrl(locale, item.series.id)}>
              {item.display.data.title}
            </a>
            <p class="series-desc">{item.display.data.description}</p>
            <p class="series-meta">
              {t.series.chapters(item.chapters.length)}
              {first.length > 0 && (
                <>
                  {t.series.readFirst}
                  {first.map((other, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={seriesUrl(locale, other.series.id)}>{other.display.data.title}</a>
                    </>
                  ))}
                </>
              )}
            </p>
          </div>
        </li>
      );
    })
  }
</ol>
