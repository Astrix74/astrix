---
import { getImage } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import PostList from '../../components/PostList.astro';
import PostMeta from '../../components/PostMeta.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { site } from '../../config/site';
import { getPosts } from '../../lib/posts';
import { relatedPosts } from '../../lib/tags';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { id: post.id },
    // Posts are newest first, so the next index is the older post.
    props: { post, newer: posts[index - 1], older: posts[index + 1], related: relatedPosts(post, posts) },
  }));
}

const { post, newer, older, related } = Astro.props;
const { Content, headings } = await render(post);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareUrl = `https://x.com/intent/post?${new URLSearchParams({ text: post.data.title, url: canonical })}`;

// The cover image if the post has one, otherwise the card generated by src/pages/og/[...route].ts.
const image = post.data.cover
  ? (await getImage({ src: post.data.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : `/og/${post.id}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { '@type': 'Person', name: site.author, url: new URL('/', Astro.site).href },
  mainEntityOfPage: post.data.canonical ?? canonical,
  image: new URL(image, Astro.site).href,
  ...(post.data.tags.length > 0 && { keywords: post.data.tags.join(', ') }),
};

const projectRef = post.data.project;
const projectEntry = projectRef ? await getEntry('projects', projectRef) : undefined;
const project = projectRef
  ? {
      name: projectEntry?.data.name ?? projectRef,
      description: projectEntry?.data.description,
      url: projectEntry?.data.url ?? `https://github.com/${projectRef.includes('/') ? projectRef : `${site.github}/${projectRef}`}`,
    }
  : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  canonical={post.data.canonical}
  image={image}
  jsonLd={jsonLd}
>
  <article>
    <a class="back" href="/writing/">← writing</a>
    <h1 class="post-title">{post.data.title}</h1>
    <PostMeta post={post} />
    <TableOfContents headings={headings} />

    <div class="prose">
      <Content />
    </div>

    {
      project && (
        <aside class="related" aria-label="Related project">
          <span class="related-label">Project</span>
          <a class="related-name" href={project.url}>
            {project.name}
          </a>
          {project.description && <span class="related-desc">{project.description}</span>}
        </aside>
      )
    }

    {
      related.length > 0 && (
        <section class="more-posts" aria-labelledby="related-posts">
          <h2 class="label" id="related-posts">
            Related
          </h2>
          <PostList posts={related} />
        </section>
      )
    }

    <div class="post-links">
      <a href={shareUrl}>Share on X</a>
      <a href="/rss.xml">RSS</a>
    </div>

    <nav class="pager" aria-label="More posts">
      {older ? <a href={`/writing/${older.id}/`}>← {older.data.title}</a> : <span />}
      {newer ? <a href={`/writing/${newer.id}/`}>{newer.data.title} →</a> : <span />}
    </nav>

    <Comments />
  </article>
</BaseLayout>

<script>
  // Section links and copy buttons. The post reads the same without this script.
  for (const heading of document.querySelectorAll<HTMLHeadingElement>('.prose h2[id], .prose h3[id]')) {
    const link = document.createElement('a');
    link.className = 'anchor';
    link.href = `#${heading.id}`;
    link.textContent = '#';
    link.setAttribute('aria-label', `Link to this section: ${heading.textContent}`);
    heading.append(link);
  }

  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const code = pre.querySelector('code');
    if (!code) continue;

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy';
    button.textContent = 'copy';
    button.setAttribute('aria-label', 'Copy this code to the clipboard');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.innerText);
        button.textContent = 'copied';
      } catch {
        button.textContent = 'failed';
      }
      setTimeout(() => (button.textContent = 'copy'), 1500);
    });

    wrapper.append(pre, button);
  }
</script>
