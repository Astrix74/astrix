---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReferenceList from '../components/ReferenceList.astro';
import type { Locale } from '../i18n';
import { strings } from '../i18n/strings';
import { getCitedReferences } from '../lib/references';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const cited = await getCitedReferences(locale);
const citedBy = new Map(cited.map(({ reference, citedBy }) => [reference.id, citedBy]));
---

<BaseLayout locale={locale} title={t.reading.title} description={t.reading.description}>
  <h1 class="page-title">{t.reading.title}</h1>
  <p class="page-intro">{t.reading.intro}</p>
  {
    cited.length > 0 ? (
      <ReferenceList references={cited.map(({ reference }) => reference)} locale={locale} citedBy={citedBy} />
    ) : (
      <p class="empty">{t.nothingHere}</p>
    )
  }
</BaseLayout>
