---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import SeriesList from '../components/SeriesList.astro';
import { site, socials } from '../config/site';
import { getPapers } from '../lib/papers';
import { formatDate, getPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';
import { getSeries } from '../lib/series';

const series = await getSeries();
const papers = (await getPapers()).slice(0, 3);
const posts = (await getPosts()).slice(0, 4);
const projects = (await getProjects()).slice(0, site.projects.homeCount);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.title,
  url: new URL('/', Astro.site).href,
  description: site.description,
};
---

<BaseLayout jsonLd={jsonLd}>
  <h1 class="sr-only">{site.title}</h1>

  <section class="section">
    <p class="lead">
      I'm {site.author}, a developer who loves AI and building things with it. Coding agents like Claude Code and Codex
      are part of my everyday work, and right now I'm digging into how deep learning works underneath: backpropagation,
      transformers, and the harnesses that turn models into agents. This site is where that work collects.
    </p>
  </section>

  {
    series.length > 0 && (
      <section class="section">
        <h2 class="label">Series</h2>
        <SeriesList items={series} />
      </section>
    )
  }

  {
    papers.length > 0 && (
      <section class="section">
        <h2 class="label">Papers</h2>
        <ul class="entries">
          {papers.map((paper) => (
            <li>
              <time class="date" datetime={paper.data.date.toISOString()}>
                {formatDate(paper.data.date)}
              </time>
              <a href={`/papers/${paper.id}/`}>{paper.data.title}</a>
            </li>
          ))}
        </ul>
        <a class="more" href="/papers/">All papers</a>
      </section>
    )
  }

  <section class="section">
    <h2 class="label">Writing</h2>
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="empty">Nothing published yet.</p>}
    {posts.length > 0 && <a class="more" href="/writing/">All posts</a>}
  </section>

  {
    projects.length > 0 && (
      <section class="section">
        <h2 class="label">Projects</h2>
        <ProjectList projects={projects} />
        <a class="more" href="/projects/">All projects</a>
      </section>
    )
  }

  <section class="section">
    <h2 class="label">Elsewhere</h2>
    <div class="elsewhere">
      {socials.map((social) => <a href={social.href}>{social.label}</a>)}
    </div>
  </section>
</BaseLayout>
