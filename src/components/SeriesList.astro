---
import { seriesUrl, type SeriesWithChapters } from '../lib/series';

interface Props {
  items: SeriesWithChapters[];
}

const { items } = Astro.props;
const visible = new Map(items.map(({ series }) => [series.id, series]));

// Prerequisites are listed only when they are themselves visible.
const meta = ({ series, chapters }: SeriesWithChapters) => {
  const first = series.data.prerequisites.flatMap(({ id }) => visible.get(id) ?? []);
  return { count: `${chapters.length} ${chapters.length === 1 ? 'chapter' : 'chapters'}`, first };
};
---

<ol class="series-list">
  {
    items.map((item, index) => {
      const { count, first } = meta(item);
      return (
        <li>
          <span class="date">{String(index + 1).padStart(2, '0')}</span>
          <div class="series-item">
            <a class="series-title" href={seriesUrl(item.series.id)}>
              {item.series.data.title}
            </a>
            <p class="series-desc">{item.series.data.description}</p>
            <p class="series-meta">
              {count}
              {first.length > 0 && (
                <>
                  {' · read first: '}
                  {first.map((series, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={seriesUrl(series.id)}>{series.data.title}</a>
                    </>
                  ))}
                </>
              )}
            </p>
          </div>
        </li>
      );
    })
  }
</ol>
