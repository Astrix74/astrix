---
import { getImage } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/Byline.astro';
import Comments from '../../components/Comments.astro';
import PostList from '../../components/PostList.astro';
import PostMeta from '../../components/PostMeta.astro';
import ProseScripts from '../../components/ProseScripts.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { site } from '../../config/site';
import { getPosts } from '../../lib/posts';
import { referencesOf } from '../../lib/references';
import { getSeries, seriesUrl } from '../../lib/series';
import { relatedPosts } from '../../lib/tags';

export async function getStaticPaths() {
  const posts = await getPosts();
  const allSeries = await getSeries();
  return posts.map((post, index) => {
    const inSeries = allSeries.find(({ series }) => series.id === post.data.series?.id);
    const position = inSeries ? inSeries.chapters.findIndex((chapter) => chapter.id === post.id) : -1;
    return {
      params: { id: post.id },
      props: {
        post,
        // Posts are newest first, so the next index is the older post.
        newer: posts[index - 1],
        older: posts[index + 1],
        series: inSeries?.series,
        previousChapter: inSeries?.chapters[position - 1],
        nextChapter: inSeries?.chapters[position + 1],
        // Other chapters of the same series are already linked from the chapter pager.
        related: relatedPosts(post, inSeries ? posts.filter((other) => other.data.series?.id !== inSeries.series.id) : posts),
      },
    };
  });
}

const { post, newer, older, series, previousChapter, nextChapter, related } = Astro.props;
const { Content, headings } = await render(post);
const references = await referencesOf(post);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareUrl = `https://x.com/intent/post?${new URLSearchParams({ text: post.data.title, url: canonical })}`;

// The cover image if the post has one, otherwise the card generated by src/pages/og/[...route].ts.
const image = post.data.cover
  ? (await getImage({ src: post.data.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : `/og/${post.id}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { '@type': 'Person', name: site.author, url: new URL('/', Astro.site).href },
  mainEntityOfPage: post.data.canonical ?? canonical,
  image: new URL(image, Astro.site).href,
  ...(post.data.tags.length > 0 && { keywords: post.data.tags.join(', ') }),
  ...(series && {
    position: post.data.chapter,
    isPartOf: { '@type': 'CreativeWorkSeries', name: series.data.title, url: new URL(seriesUrl(series.id), Astro.site).href },
  }),
};

const projectRef = post.data.project;
const projectEntry = projectRef ? await getEntry('projects', projectRef) : undefined;
const project = projectRef
  ? {
      name: projectEntry?.data.name ?? projectRef,
      description: projectEntry?.data.description,
      url: projectEntry?.data.url ?? `https://github.com/${projectRef.includes('/') ? projectRef : `${site.github}/${projectRef}`}`,
    }
  : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  canonical={post.data.canonical}
  image={image}
  jsonLd={jsonLd}
>
  <article>
    <a class="back" href="/writing/">← writing</a>
    <h1 class="post-title">{post.data.title}</h1>
    <PostMeta post={post} />
    {
      series && (
        <p class="chapter-line">
          Chapter {post.data.chapter} · <a href={seriesUrl(series.id)}>{series.data.title}</a>
        </p>
      )
    }
    <Byline writtenBy={post.data.writtenBy} />
    <TableOfContents headings={headings} />

    <div class="prose">
      <Content />
    </div>

    {
      references.length > 0 && (
        <section class="more-posts" aria-labelledby="post-references">
          <h2 class="label" id="post-references">
            References
          </h2>
          <ReferenceList references={references} />
        </section>
      )
    }

    {
      project && (
        <aside class="related" aria-label="Related project">
          <span class="related-label">Project</span>
          <a class="related-name" href={project.url}>
            {project.name}
          </a>
          {project.description && <span class="related-desc">{project.description}</span>}
        </aside>
      )
    }

    {
      related.length > 0 && (
        <section class="more-posts" aria-labelledby="related-posts">
          <h2 class="label" id="related-posts">
            Related
          </h2>
          <PostList posts={related} />
        </section>
      )
    }

    <div class="post-links">
      <a href={shareUrl}>Share on X</a>
      <a href="/rss.xml">RSS</a>
    </div>

    {
      series ? (
        <nav class="pager" aria-label="Chapters">
          {previousChapter ? (
            <a href={`/writing/${previousChapter.id}/`}>
              ← Ch {previousChapter.data.chapter}: {previousChapter.data.title}
            </a>
          ) : (
            <span />
          )}
          {nextChapter ? (
            <a href={`/writing/${nextChapter.id}/`}>
              Ch {nextChapter.data.chapter}: {nextChapter.data.title} →
            </a>
          ) : (
            <a href={seriesUrl(series.id)}>All chapters →</a>
          )}
        </nav>
      ) : (
        <nav class="pager" aria-label="More posts">
          {older ? <a href={`/writing/${older.id}/`}>← {older.data.title}</a> : <span />}
          {newer ? <a href={`/writing/${newer.id}/`}>{newer.data.title} →</a> : <span />}
        </nav>
      )
    }

    <Comments />
  </article>
  <ProseScripts />
</BaseLayout>
