---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/Byline.astro';
import ProseScripts from '../../components/ProseScripts.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import { formatDate } from '../../lib/posts';
import { getNotes } from '../../lib/notes';
import { referencesOf } from '../../lib/references';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const references = await referencesOf(note);
---

<BaseLayout title={note.data.title} description={`A short note from ${formatDate(note.data.date)}.`} type="article">
  <link slot="head" rel="alternate" type="application/rss+xml" title="Astrix notes" href="/notes/rss.xml" />
  <article>
    <a class="back" href="/notes/">← notes</a>
    <h1 class="post-title">{note.data.title}</h1>
    <p class="post-meta">
      <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
      {note.data.draft && ' · draft'}
    </p>
    <Byline writtenBy={note.data.writtenBy} />
    <div class="prose">
      <Content />
    </div>
    {
      references.length > 0 && (
        <section class="more-posts" aria-labelledby="note-references">
          <h2 class="label" id="note-references">
            References
          </h2>
          <ReferenceList references={references} />
        </section>
      )
    }
  </article>
  <ProseScripts />
</BaseLayout>
