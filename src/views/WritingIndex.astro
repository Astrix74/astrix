---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { localize, type Locale } from '../i18n';
import { strings } from '../i18n/strings';
import { getPosts } from '../lib/posts';
import { collectTags } from '../lib/tags';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const p = (path: string) => localize(locale, path);
const posts = await getPosts(locale);
const years = [...new Set(posts.map((post) => post.data.date.getUTCFullYear()))];
const hasTags = collectTags(posts).length > 0;
---

<BaseLayout locale={locale} title={t.writing.title} description={t.writing.description}>
  <h1 class="page-title">{t.writing.title}</h1>
  <p class="page-intro" set:html={t.writing.intro(p)} />
  {hasTags && <p class="page-meta"><a href={p('/writing/tags/')}>{t.writing.browseByTag}</a></p>}
  {
    years.length > 0 ? (
      years.map((year) => (
        <section class="section">
          <h2 class="label">{year}</h2>
          <PostList posts={posts.filter((post) => post.data.date.getUTCFullYear() === year)} />
        </section>
      ))
    ) : (
      <p class="empty">{t.nothingPublished}</p>
    )
  }
</BaseLayout>
