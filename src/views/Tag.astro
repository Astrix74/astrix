---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { localize, type Alternates, type Locale } from '../i18n';
import { strings } from '../i18n/strings';
import type { Post } from '../lib/posts';

interface Props {
  tag: string;
  posts: Post[];
  locale: Locale;
  alternates: Alternates;
}

const { tag, posts, locale, alternates } = Astro.props;
const t = strings[locale];
---

<BaseLayout locale={locale} alternates={alternates} title={t.tags.tagged(tag)} description={t.tags.taggedDescription(tag)}>
  <a class="back" href={localize(locale, '/writing/tags/')}>{t.tags.back}</a>
  <h1 class="page-title">{t.tags.tagged(tag)}</h1>
  <PostList posts={posts} />
</BaseLayout>
